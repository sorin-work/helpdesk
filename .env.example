# Copy to .env and adjust. docker compose reads this file automatically.

# Host ports
DB_PORT=5450
API_PORT=4410
WEB_PORT=5190

POSTGRES_PASSWORD=helpdesk
# Use a long random string anywhere outside your laptop.
JWT_SECRET=local-development-secret-change-me-0123456789
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
LOG_LEVEL=info

# Attachments
MAX_UPLOAD_MB=10
